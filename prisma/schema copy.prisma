datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. "STUDENT", "INSTRUCTOR", "ADMIN", "SUPER_ADMIN"
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

model User {
  id                 String              @id @default(uuid())
  name               String?
  email              String              @unique
  emailVerified      DateTime?           @map("email_verified")
  passwordHash       String?             @map("password_hash")
  image              String?
  roleId             String?             @map("role_id")
  role               Role?               @relation(fields: [roleId], references: [id])
  profile            Profile?
  accounts           Account[]
  sessions           Session[]
  enrollments        Enrollment[]
  lessonProgress     LessonProgress[]
  submissions        Submission[]
  assessmentAttempts AssessmentAttempt[]
  projectSubmissions ProjectSubmission[]
  readinessScores    ReadinessScore[]
  reviews            Review[]
  reviewReports      ReviewReport[]      @relation("reporter")
  certificates       Certificate[]
  badges             Badge[]
  notifications      Notification[]
  savedItems         SavedItem[]
  subscriptions      Subscription[]
  orders             Order[]
  userTopicProgress  UserTopicProgress[]
  userDsaProgress    UserDsaProgress[]
  supportRequests    SupportRequest[]
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@map("users")
}

model Profile {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  college         String?
  degree          String?
  branch          String?
  gradYear        Int?     @map("grad_year")
  careerGoal      String?  @map("career_goal")
  skills          String? // Comma-separated list for wide db engine compatibility
  experienceLevel String?  @map("experience_level")
  interests       String?
  githubUrl       String?  @map("github_url")
  linkedinUrl     String?  @map("linkedin_url")
  portfolioUrl    String?  @map("portfolio_url")
  resumeUrl       String?  @map("resume_url")
  bio             String?
  createdAt       DateTime @default(now()) @map("created_at")
    updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

model TeamMember {
  id           String   @id @default(uuid())
  name         String
  email        String?
  role         String // Founder, Developer, UI/UX, etc.
  photoUrl     String?  @map("photo_url")
  bio          String?
  skills       String? // Comma-separated list
  githubUrl    String?  @map("github_url")
  linkedinUrl  String?  @map("linkedin_url")
  portfolioUrl String?  @map("portfolio_url")
  joinedDate   DateTime @default(now()) @map("joined_date")
  isFounder    Boolean  @default(false) @map("is_founder")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("team_members")
}

// NextAuth standard models
model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model CareerPath {
  id                 String    @id @default(uuid())
  title              String
  description        String
  skills             String // Comma-separated
  languages          String // Comma-separated
  technologies       String // Comma-separated
  placementRelevance String
  roadmaps           Roadmap[]
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("career_paths")
}

model Roadmap {
  id           String         @id @default(uuid())
  title        String
  description  String
  careerPathId String         @map("career_path_id")
  careerPath   CareerPath     @relation(fields: [careerPathId], references: [id], onDelete: Cascade)
  stages       RoadmapStage[]
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@map("roadmaps")
}

model RoadmapStage {
  id          String         @id @default(uuid())
  title       String
  description String
  position    Int
  roadmapId   String         @map("roadmap_id")
  roadmap     Roadmap        @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  topics      StageTopic[]
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@map("roadmap_stages")
}

model Course {
  id           String         @id @default(uuid())
  title        String
  description  String
  difficulty   String // BEGINNER, INTERMEDIATE, ADVANCED
  isPremium    Boolean        @default(false) @map("is_premium")
  modules      CourseModule[]
  enrollments  Enrollment[]
  reviews      Review[]
  resources    Resource[]
  certificates Certificate[]
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@map("courses")
}

model CourseModule {
  id          String   @id @default(uuid())
  title       String
  description String
  position    Int
  courseId    String   @map("course_id")
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("course_modules")
}

model Lesson {
  id        String           @id @default(uuid())
  title     String
  type      String // VIDEO, ARTICLE, DOCUMENT
  content   String? // Markdown or article text
  videoUrl  String?          @map("video_url")
  duration  Int // in minutes
  position  Int
  moduleId  String           @map("module_id")
  module    CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress  LessonProgress[]
  resources Resource[]
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@map("lessons")
}

model Resource {
  id          String   @id @default(uuid())
  title       String
  description String?
  url         String
  type        String // YOUTUBE, DOCUMENTATION, ARTICLE, BOOK
  difficulty  String // BEGINNER, INTERMEDIATE, ADVANCED
  source      String? // e.g. "YouTube", "MDN"
  courseId    String?  @map("course_id")
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId    String?  @map("lesson_id")
  lesson      Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("resources")
}

model Enrollment {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId           String   @map("course_id")
  course             Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status             String // ENROLLED, COMPLETED
  progressPercentage Int      @default(0) @map("progress_percentage")
  enrolledAt         DateTime @default(now()) @map("enrolled_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([userId, courseId])
  @@map("enrollments")
}

model LessonProgress {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String    @map("lesson_id")
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

model QuestionTopic {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  questions   Question[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("question_topics")
}

model Question {
  id               String        @id @default(uuid())
  title            String
  description      String
  difficulty       String // EASY, MEDIUM, HARD
  language         String // e.g. "JavaScript", "Python", "SQL"
  companyRelevance String?       @map("company_relevance") // Comma-separated company names
  tags             String? // Comma-separated
  topicId          String        @map("topic_id")
  topic            QuestionTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  submissions      Submission[]
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@map("questions")
}

model Submission {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String   @map("question_id")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  status     String // ATTEMPTED, SOLVED, FAILED
  code       String
  score      Int      @default(0)
  solvedAt   DateTime @default(now()) @map("solved_at")

  @@map("submissions")
}

model Assessment {
  id             String              @id @default(uuid())
  title          String
  duration       Int // in minutes
  totalQuestions Int                 @map("total_questions")
  type           String // APTITUDE, LOGICAL, VERBAL, CS_MCQ
  attempts       AssessmentAttempt[]
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@map("assessments")
}

model AssessmentAttempt {
  id           String             @id @default(uuid())
  userId       String             @map("user_id")
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessmentId String             @map("assessment_id")
  assessment   Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  score        Int                @default(0)
  startedAt    DateTime           @default(now()) @map("started_at")
  endedAt      DateTime?          @map("ended_at")
  results      AssessmentResult[]

  @@map("assessment_attempts")
}

model AssessmentResult {
  id             String            @id @default(uuid())
  attemptId      String            @map("attempt_id")
  attempt        AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     String            @map("question_id")
  selectedOption String            @map("selected_option")
  isCorrect      Boolean           @map("is_correct")

  @@map("assessment_results")
}

model Project {
  id               String              @id @default(uuid())
  title            String
  description      String
  problemStatement String              @map("problem_statement")
  level            String // BEGINNER, INTERMEDIATE, ADVANCED
  technologies     String // Comma-separated
  architecture     String?
  requirements     String?
  milestones       String? // Comma-separated or serialized
  tasks            ProjectTask[]
  userProjects     ProjectSubmission[]
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@map("projects")
}

model ProjectTask {
  id          String   @id @default(uuid())
  title       String
  description String
  position    Int
  projectId   String   @map("project_id")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("project_tasks")
}

model ProjectSubmission {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String   @map("project_id")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  githubUrl   String?  @map("github_url")
  liveUrl     String?  @map("live_url")
  status      String // IN_PROGRESS, SUBMITTED, COMPLETED
  submittedAt DateTime @default(now()) @map("submitted_at")

  @@unique([userId, projectId])
  @@map("project_submissions")
}

model Company {
  id                 String              @id @default(uuid())
  name               String              @unique
  description        String
  eligibility        String?
  selectionProcess   String?             @map("selection_process")
  prepTopics         String?             @map("prep_topics")
  roles              CompanyRole[]
  interviewQuestions InterviewQuestion[]
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@map("companies")
}

model CompanyRole {
  id        String   @id @default(uuid())
  name      String
  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("company_roles")
}

model InterviewQuestion {
  id        String   @id @default(uuid())
  question  String
  answer    String
  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category  String // TECHNICAL, HR, BEHAVIORAL
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("interview_questions")
}

model PlacementResource {
  id          String   @id @default(uuid())
  title       String
  description String?
  url         String
  type        String // APTITUDE, CODING, CS_CORE, INTERVIEW
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("placement_resources")
}

model ReadinessScore {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dsa         Int      @default(0)
  programming Int      @default(0)
  coreCs      Int      @default(0)
  projects    Int      @default(0)
  aptitude    Int      @default(0)
  interview   Int      @default(0)
  resume      Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("readiness_scores")
}

model Review {
  id           String         @id @default(uuid())
  userId       String         @map("user_id")
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId     String         @map("course_id")
  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  rating       Int
  comment      String
  isVerified   Boolean        @default(false) @map("is_verified")
  helpfulCount Int            @default(0) @map("helpful_count")
  reports      ReviewReport[]
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@map("reviews")
}

model ReviewReport {
  id         String   @id @default(uuid())
  reviewId   String   @map("review_id")
  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporterId String   @map("reporter_id")
  reporter   User     @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("review_reports")
}

model Certificate {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String   @map("course_id")
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  achievementText String   @map("achievement_text")
  issueDate       DateTime @default(now()) @map("issue_date")
  verificationUrl String   @map("verification_url")
  status          String // VALID, REVOKED
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("certificates")
}

model Badge {
  id          String   @id @default(uuid())
  name        String
  description String
  iconUrl     String?  @map("icon_url")
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  earnedAt    DateTime @default(now()) @map("earned_at")

  @@map("badges")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  type      String // COURSE, ASSESSMENT, PROJECT, CERTIFICATE, SYSTEM
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model SavedItem {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // COURSE, LESSON, RESOURCE, QUESTION, PROJECT, COMPANY
  targetId  String   @map("target_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("saved_items")
}

model Subscription {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            String // ACTIVE, INACTIVE, CANCELLED
  plan              String // e.g. "PRO"
  expiresAt         DateTime? @map("expires_at")
  cancelAtPeriodEnd Boolean   @default(false) @map("cancel_at_period_end")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("subscriptions")
}

model Order {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount            Int
  status            String // PENDING, SUCCESS, FAILED
  razorpayOrderId   String?  @map("razorpay_order_id")
  razorpayPaymentId String?  @map("razorpay_payment_id")
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("orders")
}

// =====================================================
// ROADMAP TOPICS — learning content within a stage
// =====================================================

model StageTopic {
  id           String              @id @default(uuid())
  title        String
  description  String
  youtubeUrl   String?             @map("youtube_url")
  quizJson     String?             @map("quiz_json")
  position     Int
  stageId      String              @map("stage_id")
  stage        RoadmapStage        @relation(fields: [stageId], references: [id], onDelete: Cascade)
  userProgress UserTopicProgress[]
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@map("stage_topics")
}

model UserTopicProgress {
  id          String     @id @default(uuid())
  userId      String     @map("user_id")
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId     String     @map("topic_id")
  topic       StageTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  isCompleted Boolean    @default(false) @map("is_completed")
  notes       String?
  completedAt DateTime?  @map("completed_at")

  @@unique([userId, topicId])
  @@map("user_topic_progress")
}

// =====================================================
// DSA FOUNDATION — schema & MVP functionality
// Easy → Medium → Hard → Expert
// =====================================================

model DsaProblem {
  id                  String            @id @default(uuid())
  title               String
  description         String
  difficulty          String            // EASY, MEDIUM, HARD, EXPERT
  tags                String?           // Comma-separated: "arrays, two-pointers"
  companyRelevance    String?           @map("company_relevance") // Comma-separated company names
  examplesJson        String?           @map("examples_json")
  constraints         String?
  solutionCode        String?           @map("solution_code")
  solutionExplanation String?           @map("solution_explanation")
  hints               DsaHint[]
  userProgress        UserDsaProgress[]
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  @@map("dsa_problems")
}

model DsaHint {
  id        String     @id @default(uuid())
  problemId String     @map("problem_id")
  problem   DsaProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  position  Int        // 1 or 2 (max 2 hints per problem)
  content   String

  @@map("dsa_hints")
}

// Tracks per-user DSA progress and daily hint usage
model UserDsaProgress {
  id            String     @id @default(uuid())
  userId        String     @map("user_id")
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId     String     @map("problem_id")
  problem       DsaProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  status        String     @default("UNSEEN") // UNSEEN, ATTEMPTED, SOLVED
  hintsUsed     Int        @default(0) @map("hints_used")          // per-problem hint count (max 2)
  dailyHints    Int        @default(0) @map("daily_hints")         // resets daily (max 5/day)
  dailyHintsDate DateTime? @map("daily_hints_date")               // date of last hint usage
  solvedAt      DateTime?  @map("solved_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@unique([userId, problemId])
  @@map("user_dsa_progress")
}

// =====================================================
// SUPPORT REQUESTS — Code404 Contact Support System
// =====================================================

model SupportRequest {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("support_requests")
}

